{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "CAP Theorem: Consistency vs Availability During a Network Partition",
    "output": "diagram.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "flow",
      "label": "System State"
    },
    {
      "id": "cp",
      "label": "Consistency Path (CP)",
      "variant": "exception"
    },
    {
      "id": "ap",
      "label": "Availability Path (AP)"
    }
  ],
  "phases": [
    {
      "id": "normal",
      "label": "Normal",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "fault",
      "label": "Partition Occurs",
      "fromCol": 2,
      "toCol": 3
    },
    {
      "id": "tradeoff",
      "label": "CAP Trade-off",
      "fromCol": 4,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "recover",
      "label": "Recovery",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "client",
    "sync_state",
    "partition",
    "read_b",
    "ap_choice",
    "reconcile"
  ],
  "nodes": [
    {
      "id": "client",
      "lane": "flow",
      "col": 0,
      "type": "external",
      "label": "Client",
      "sublabel": "reads/writes data",
      "width": 150
    },
    {
      "id": "sync_state",
      "lane": "flow",
      "col": 1,
      "type": "database",
      "label": "Node A & B",
      "sublabel": "normally in sync",
      "width": 150
    },
    {
      "id": "partition",
      "lane": "flow",
      "col": 2,
      "type": "security",
      "label": "Network Partition",
      "sublabel": "A <-> B disconnected",
      "width": 150
    },
    {
      "id": "read_b",
      "lane": "flow",
      "col": 3,
      "type": "external",
      "label": "Read from Node B",
      "sublabel": "during the partition",
      "width": 150
    },
    {
      "id": "cp_choice",
      "lane": "cp",
      "col": 4,
      "type": "security",
      "label": "CP: Reject/Error",
      "sublabel": "waiting to confirm with A",
      "width": 150
    },
    {
      "id": "ap_choice",
      "lane": "ap",
      "col": 4,
      "type": "backend",
      "label": "AP: Return Stale Data",
      "sublabel": "may be stale",
      "width": 150
    },
    {
      "id": "reconcile",
      "lane": "flow",
      "col": 5,
      "type": "database",
      "label": "Partition Heals",
      "sublabel": "re-sync A & B",
      "width": 150
    }
  ],
  "edges": [
    {
      "id": "client-sync",
      "from": "client",
      "to": "sync_state",
      "variant": "default"
    },
    {
      "id": "sync-partition",
      "from": "sync_state",
      "to": "partition",
      "label": "network failure",
      "variant": "default"
    },
    {
      "id": "partition-read",
      "from": "partition",
      "to": "read_b",
      "label": "client still calls Node B",
      "variant": "default"
    },
    {
      "id": "read-cp",
      "from": "read_b",
      "to": "cp_choice",
      "label": "choose Consistency",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "read-ap",
      "from": "read_b",
      "to": "ap_choice",
      "label": "choose Availability",
      "variant": "emphasis",
      "role": "branch"
    },
    {
      "id": "cp-reconcile",
      "from": "cp_choice",
      "to": "reconcile",
      "variant": "security",
      "role": "return"
    },
    {
      "id": "ap-reconcile",
      "from": "ap_choice",
      "to": "reconcile",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "orange",
      "title": "What Is CAP",
      "items": [
        "Consistency: every node returns the same, most recent data",
        "Availability: every request still gets a response (no error)",
        "Partition tolerance: the system keeps working when the network is split"
      ]
    },
    {
      "dot": "rose",
      "title": "When a Partition Happens",
      "items": [
        "P is essentially unavoidable in a real distributed system",
        "The real question is choosing C or A when P happens, not choosing all three"
      ]
    }
  ]
}
