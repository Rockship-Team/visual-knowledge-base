{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Deadlock: Circular Wait Between Two Transactions",
    "output": "deadlock-circular-wait.html",
    "viewBox": [900, 620],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "txnA", "type": "external", "label": "Transaction A", "sublabel": "client session" },
    { "id": "txnB", "type": "external", "label": "Transaction B", "sublabel": "client session" },
    { "id": "db", "type": "database", "label": "Database", "sublabel": "lock manager" }
  ],
  "segments": [
    { "from": 145, "to": 265, "label": "A and B lock different rows" },
    { "from": 265, "to": 385, "label": "Circular wait: each waits on the other's lock" },
    { "from": 385, "to": 445, "label": "Deadlock detector picks a victim, rolls back B" },
    { "from": 445, "to": 505, "label": "A proceeds and commits" }
  ],
  "messages": [
    { "id": "a-lock-row1", "from": "txnA", "to": "db", "y": 160, "label": "LOCK Row 1", "variant": "default" },
    { "id": "a-lock-row1-ok", "from": "db", "to": "txnA", "y": 190, "label": "OK (lock granted)", "variant": "return" },
    { "id": "b-lock-row2", "from": "txnB", "to": "db", "y": 220, "label": "LOCK Row 2", "variant": "default" },
    { "id": "b-lock-row2-ok", "from": "db", "to": "txnB", "y": 250, "label": "OK (lock granted)", "variant": "return" },
    { "id": "a-lock-row2-req", "from": "txnA", "to": "db", "y": 280, "label": "LOCK Row 2 (request)", "variant": "default" },
    { "id": "a-waiting", "from": "db", "to": "txnA", "y": 310, "label": "WAITING... for B to release", "variant": "dashed" },
    { "id": "b-lock-row1-req", "from": "txnB", "to": "db", "y": 340, "label": "LOCK Row 1 (request)", "variant": "default" },
    { "id": "b-waiting", "from": "db", "to": "txnB", "y": 370, "label": "WAITING... deadlock!", "variant": "dashed" },
    { "id": "deadlock-abort", "from": "db", "to": "txnB", "y": 400, "label": "DEADLOCK: ABORT B", "variant": "emphasis" },
    { "id": "a-lock-row2-ok", "from": "db", "to": "txnA", "y": 430, "label": "LOCK Row 2 OK (B rolled back)", "variant": "return" },
    { "id": "a-commit", "from": "txnA", "to": "db", "y": 460, "label": "COMMIT", "variant": "default" },
    { "id": "a-commit-ok", "from": "db", "to": "txnA", "y": 490, "label": "OK", "variant": "return" }
  ],
  "activations": [
    { "participant": "db", "from": 160, "to": 495, "type": "database" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Where the circular wait happens",
      "items": [
        "A holds the lock on Row 1, then requests Row 2",
        "B holds the lock on Row 2, then requests Row 1",
        "Both get blocked: each is waiting on a lock the other holds — a closed wait cycle"
      ]
    },
    {
      "dot": "orange",
      "title": "Root cause",
      "items": [
        "No consistent lock ordering across transactions",
        "All four Coffman conditions are met: mutual exclusion, hold-and-wait, no preemption, circular wait",
        "The longer a transaction runs and the more rows it locks, the higher the odds of a deadlock"
      ]
    },
    {
      "dot": "emerald",
      "title": "How to fix it",
      "items": [
        "Enforce the same global lock order across every transaction (e.g. always lock by ascending id)",
        "Keep transactions short, commit early, minimize lock hold time",
        "Use SELECT ... FOR UPDATE NOWAIT or SKIP LOCKED to avoid blocking indefinitely",
        "Let the database detect the deadlock, abort a victim, and retry at the application layer"
      ]
    }
  ]
}
