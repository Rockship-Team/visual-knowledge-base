  "activations": [
    { "participant": "redis", "from": 165, "to": 195, "type": "database" },
    { "participant": "redis", "from": 225, "to": 255, "type": "database" },
    { "participant": "redis", "from": 285, "to": 315, "type": "database" },
    { "participant": "db", "from": 345, "to": 375, "type": "database" },
    { "participant": "redis", "from": 405, "to": 435, "type": "database" },
    { "participant": "redis", "from": 465, "to": 495, "type": "database" },
    { "participant": "db", "from": 525, "to": 555, "type": "database" },
    { "participant": "redis", "from": 585, "to": 615, "type": "database" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "How the race condition is prevented",
      "items": [
        "Both instances want to run the critical section, but only one holds the lock at a time",
        "The other instance is rejected by Redis (NX fails) and must retry",
        "Only after A releases the lock does B acquire it and proceed — no more overlapping read-modify-write"
      ]
    },
    {
      "dot": "orange",
      "title": "Requirements for a correct distributed lock",
      "items": [
        "TTL/PX is mandatory: if the lock holder crashes, the lock expires automatically instead of blocking forever",
        "A unique token per acquire: only delete the lock if the token still matches, to avoid deleting another instance's lock after TTL expiry",
        "SET NX and delete-if-token-matches must be atomic (Lua script) to avoid a race inside the locking logic itself"
      ]
    },
    {
      "dot": "emerald",
      "title": "Known limitations",
      "items": [
        "Redlock (multiple Redis nodes) is still debated for safety when clocks/network aren't ideal",
        "For high-correctness requirements, combine it with a fencing token on the protected resource",
        "With a single Redis instance, this is a simple solution that's good enough for most real-world use cases"
      ]
    }
  ]
}
