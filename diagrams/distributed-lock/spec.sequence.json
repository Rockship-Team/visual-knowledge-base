    { "id": "redis", "type": "database", "label": "Redis", "sublabel": "lock store" },
    { "id": "db", "type": "database", "label": "Database", "sublabel": "balance = 100" }
  ],
  "segments": [
    { "from": 145, "to": 205, "label": "A acquires the lock" },
    { "from": 205, "to": 325, "label": "B rejected, retries" },
    { "from": 325, "to": 445, "label": "A runs critical section, releases lock" },
    { "from": 445, "to": 505, "label": "B retry succeeds" },
    { "from": 505, "to": 625, "label": "B runs critical section, releases lock" }
  ],
  "messages": [
    { "id": "a-acquire-req", "from": "instanceA", "to": "redis", "y": 160, "label": "SET lock NX PX 5000 (token=A)", "variant": "default" },
    { "id": "a-acquire-ok", "from": "redis", "to": "instanceA", "y": 190, "label": "OK (lock acquired)", "variant": "return" },
    { "id": "b-acquire-req", "from": "instanceB", "to": "redis", "y": 220, "label": "SET lock NX PX 5000 (token=B)", "variant": "default" },
    { "id": "b-acquire-fail", "from": "redis", "to": "instanceB", "y": 250, "label": "nil (key already exists)", "variant": "return" },
    { "id": "b-retry1-req", "from": "instanceB", "to": "redis", "y": 280, "label": "retry: SET lock NX (token=B)", "variant": "dashed" },
    { "id": "b-retry1-fail", "from": "redis", "to": "instanceB", "y": 310, "label": "nil (still locked)", "variant": "dashed" },
    { "id": "a-write-req", "from": "instanceA", "to": "db", "y": 340, "label": "UPDATE balance = balance + 50", "variant": "emphasis" },
    { "id": "a-write-ok", "from": "db", "to": "instanceA", "y": 370, "label": "OK", "variant": "return" },
    { "id": "a-release-req", "from": "instanceA", "to": "redis", "y": 400, "label": "DEL lock IF token = A (Lua script)", "variant": "default" },
    { "id": "a-release-ok", "from": "redis", "to": "instanceA", "y": 430, "label": "OK (lock released)", "variant": "return" },
    { "id": "b-retry2-req", "from": "instanceB", "to": "redis", "y": 460, "label": "retry: SET lock NX PX 5000 (token=B)", "variant": "default" },
    { "id": "b-retry2-ok", "from": "redis", "to": "instanceB", "y": 490, "label": "OK (lock acquired)", "variant": "return" },
    { "id": "b-write-req", "from": "instanceB", "to": "db", "y": 520, "label": "UPDATE balance = balance + 50", "variant": "emphasis" },
    { "id": "b-write-ok", "from": "db", "to": "instanceB", "y": 550, "label": "OK", "variant": "return" },
    { "id": "b-release-req", "from": "instanceB", "to": "redis", "y": 580, "label": "DEL lock IF token = B", "variant": "default" },
