{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Idempotency Key: Safe API Retries",
    "output": "idempotency-key.html",
    "viewBox": [1040, 720],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "client", "type": "external", "label": "Client", "sublabel": "mobile/web app" },
    { "id": "api", "type": "backend", "label": "API Server", "sublabel": "handles request" },
    { "id": "store", "type": "database", "label": "Idempotency Store", "sublabel": "key -> result" },
    { "id": "gateway", "type": "external", "label": "Payment Gateway", "sublabel": "charges the card" }
  ],
  "segments": [
    { "from": 145, "to": 400, "label": "First call" },
    { "from": 400, "to": 545, "label": "Timeout -> client retries with same Idempotency-Key" }
  ],
  "messages": [
    { "id": "req1", "from": "client", "to": "api", "y": 160, "label": "POST /charge (Idempotency-Key: abc123)", "variant": "default" },
    { "id": "check1", "from": "api", "to": "store", "y": 190, "label": "check key abc123", "variant": "default" },
    { "id": "notfound", "from": "store", "to": "api", "y": 220, "label": "no record yet", "variant": "return" },
    { "id": "charge", "from": "api", "to": "gateway", "y": 250, "label": "charge the card", "variant": "emphasis" },
    { "id": "charged", "from": "gateway", "to": "api", "y": 280, "label": "charged OK", "variant": "return" },
    { "id": "save", "from": "api", "to": "store", "y": 310, "label": "save result for abc123", "variant": "default" },
    { "id": "saved", "from": "store", "to": "api", "y": 340, "label": "saved", "variant": "return" },
    { "id": "resp1", "from": "api", "to": "client", "y": 370, "label": "200 OK (lost in transit, timeout)", "variant": "dashed" },
    { "id": "req2", "from": "client", "to": "api", "y": 430, "label": "POST /charge (Idempotency-Key: abc123) - retry", "variant": "default" },
    { "id": "check2", "from": "api", "to": "store", "y": 460, "label": "check key abc123", "variant": "default" },
    { "id": "found", "from": "store", "to": "api", "y": 490, "label": "result exists, return cached", "variant": "return" },
    { "id": "resp2", "from": "api", "to": "client", "y": 520, "label": "200 OK (cached, gateway not called again)", "variant": "return" }
  ],
  "activations": [
    { "participant": "api", "from": 160, "to": 525, "type": "backend" },
    { "participant": "store", "from": 195, "to": 215, "type": "database" },
    { "participant": "gateway", "from": 255, "to": 275, "type": "external" },
    { "participant": "store", "from": 315, "to": 335, "type": "database" },
    { "participant": "store", "from": 465, "to": 485, "type": "database" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "The problem without an idempotency key",
      "items": [
        "Client doesn't know if the earlier request succeeded after a timeout",
        "A naive retry resends the identical POST -> the card can get charged twice",
        "Server has no way to tell a new request from a duplicate"
      ]
    },
    {
      "dot": "orange",
      "title": "How it works",
      "items": [
        "Client generates an Idempotency-Key and sends it with every call (retries included)",
        "Server stores the key + request hash + result in the Idempotency Store",
        "On retry with the same key: return the stored result directly, without calling the gateway again"
      ]
    },
    {
      "dot": "emerald",
      "title": "Implementation notes",
      "items": [
        "Put a unique constraint on the idempotency key to prevent duplicate writes",
        "If two retries arrive nearly simultaneously, a lock/transaction is needed to avoid a race when writing to the Idempotency Store",
        "The idempotency key should have a TTL and be tied to the payload hash to prevent misuse"
      ]
    }
  ]
}
