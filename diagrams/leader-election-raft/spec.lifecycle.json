{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Leader Election: Raft Consensus Basics",
    "output": "leader-election-raft.html",
    "viewBox": [1000, 600],
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "main", "label": "Node state" }
  ],
  "states": [
    { "id": "follower", "type": "start", "label": "Follower", "sublabel": "waiting for heartbeat", "lane": "main", "col": 0, "step": "01", "tag": "entry" },
    { "id": "candidate", "type": "decision", "label": "Candidate", "sublabel": "requesting votes", "lane": "main", "col": 1, "step": "02", "tag": "election" },
    { "id": "leader", "type": "success", "label": "Leader", "sublabel": "sending periodic heartbeats", "lane": "main", "col": 2, "step": "03", "tag": "leader" }
  ],
  "transitions": [
    { "id": "follower-to-candidate", "from": "follower", "to": "candidate", "label": "election timeout", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight", "labelAt": [171, 122] },
    { "id": "candidate-to-leader", "from": "candidate", "to": "leader", "label": "wins majority vote", "variant": "emphasis", "fromSide": "right", "toSide": "left", "route": "straight", "labelAt": [325, 122] },
    { "id": "candidate-to-follower", "from": "candidate", "to": "follower", "label": "split vote, re-elect with new term", "variant": "security", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel", "channelY": 250 },
    { "id": "leader-to-follower", "from": "leader", "to": "follower", "label": "step down (higher term seen)", "variant": "security", "route": "top-channel", "channelY": 60, "fromSide": "top", "toSide": "top" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Main Path + Quorum",
      "items": [
        "A Follower only becomes a Candidate when its election timeout elapses with no heartbeat received",
        "A Candidate needs an absolute majority of votes (quorum) to become the sole Leader for that term",
        "The majority requirement guarantees at most one valid Leader per term -> prevents split-brain"
      ]
    },
    {
      "dot": "rose",
      "title": "Retry + Step Down",
      "items": [
        "A split vote sends the Candidate back to Follower, where it waits for a new randomized timeout before retrying",
        "Randomized timeouts keep many nodes from retrying at once and repeatedly splitting the vote",
        "A Leader steps down to Follower as soon as it sees a higher term from another peer"
      ]
    }
  ]
}
