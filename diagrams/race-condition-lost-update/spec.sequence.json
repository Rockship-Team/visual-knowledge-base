  "meta": {
    "title": "Race Condition: Lost Update on an Account Balance",
    "output": "race-condition-lost-update.html",
    "viewBox": [1000, 760],
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "clientA", "type": "external", "label": "Client A", "sublabel": "deposits 50" },
    { "id": "clientB", "type": "external", "label": "Client B", "sublabel": "deposits 50" },
    { "id": "api", "type": "backend", "label": "API Server", "sublabel": "handles requests" },
    { "id": "db", "type": "database", "label": "Database", "sublabel": "balance = 100" }
  ],
  "segments": [
    { "from": 145, "to": 265, "label": "A reads balance" },
    { "from": 265, "to": 385, "label": "B reads balance (stale)" },
    { "from": 385, "to": 505, "label": "A writes balance = 150" },
    { "from": 505, "to": 625, "label": "B overwrites balance = 150 (A's update is lost)" }
  ],
  "messages": [
    { "id": "a-read-req", "from": "clientA", "to": "api", "y": 160, "label": "GET /balance", "variant": "default" },
    { "id": "a-read-db", "from": "api", "to": "db", "y": 190, "label": "SELECT balance", "variant": "default" },
    { "id": "a-read-val", "from": "db", "to": "api", "y": 220, "label": "balance = 100", "variant": "return" },
    { "id": "a-read-resp", "from": "api", "to": "clientA", "y": 250, "label": "100", "variant": "return" },
    { "id": "b-read-req", "from": "clientB", "to": "api", "y": 280, "label": "GET /balance", "variant": "default" },
    { "id": "b-read-db", "from": "api", "to": "db", "y": 310, "label": "SELECT balance", "variant": "default" },
    { "id": "b-read-val", "from": "db", "to": "api", "y": 340, "label": "balance = 100 (update not seen yet)", "variant": "return" },
    { "id": "b-read-resp", "from": "api", "to": "clientB", "y": 370, "label": "100", "variant": "return" },
    { "id": "a-write-req", "from": "clientA", "to": "api", "y": 400, "label": "POST +50 (computes 150)", "variant": "default" },
    { "id": "a-write-db", "from": "api", "to": "db", "y": 430, "label": "UPDATE balance = 150", "variant": "default" },
    { "id": "a-write-ok", "from": "db", "to": "api", "y": 460, "label": "OK", "variant": "return" },
    { "id": "a-write-resp", "from": "api", "to": "clientA", "y": 490, "label": "200 OK", "variant": "return" },
    { "id": "b-write-req", "from": "clientB", "to": "api", "y": 520, "label": "POST +50 (computes 150)", "variant": "default" },
    { "id": "b-write-db", "from": "api", "to": "db", "y": 550, "label": "UPDATE balance = 150 (overwrite!)", "variant": "emphasis" },
    { "id": "b-write-ok", "from": "db", "to": "api", "y": 580, "label": "OK", "variant": "return" },
    { "id": "b-write-resp", "from": "api", "to": "clientB", "y": 610, "label": "200 OK", "variant": "return" }
  ],
  "activations": [
    { "participant": "api", "from": 160, "to": 615, "type": "backend" },
    { "participant": "db", "from": 195, "to": 215, "type": "database" },
    { "participant": "db", "from": 315, "to": 335, "type": "database" },
    { "participant": "db", "from": 435, "to": 455, "type": "database" },
    { "participant": "db", "from": 555, "to": 575, "type": "database" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Where the race condition happens",
      "items": [
        "Client A and Client B both read balance = 100 before either writes",
        "Both compute independently: 100 + 50 = 150",
        "B overwrites A's result — the final balance is 150 instead of the correct 200"
      ]
    },
    {
      "dot": "orange",
      "title": "Root cause",
      "items": [
        "The Read-Modify-Write sequence isn't atomic: read, add, write are three separate steps",
        "No lock or isolation control between the two concurrent transactions",
        "The interleaving order is decided by the scheduler — unpredictable and not stable"
      ]
    },
    {
      "dot": "emerald",
      "title": "How to fix it",
      "items": [
        "Atomic update at the DB: UPDATE balance = balance + 50 instead of read-then-compute-then-write",
        "Optimistic locking: add a version column, only write if the version still matches, otherwise retry",
        "Pessimistic locking: SELECT ... FOR UPDATE, or a mutex/semaphore at the application layer",
        "Raise the isolation level to serializable so the DB detects and rejects the conflict itself"
      ]
    }
  ]
}
